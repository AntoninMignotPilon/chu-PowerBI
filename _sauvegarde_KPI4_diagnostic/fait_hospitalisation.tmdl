	partition fait_hospitalisation = m
		mode: import
		source =
				let
				    Source = Odbc.DataSource("dsn=Hive Gold", [HierarchicalNavigation=true]),
				    HIVE_Database = Source{[Name="HIVE",Kind="Database"]}[Data],
				    gold_Schema = HIVE_Database{[Name="gold",Kind="Schema"]}[Data],
				    fait_hospitalisation_Table = gold_Schema{[Name="fait_hospitalisation",Kind="Table"]}[Data]
				in
				    fait_hospitalisation_Table

