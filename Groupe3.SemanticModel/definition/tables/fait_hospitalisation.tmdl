table fait_hospitalisation
	lineageTag: 950efa73-a506-4474-8dba-353247931ed0

	measure 'Taux global hospitalisation' =
			
			DIVIDE(DISTINCTCOUNT(fait_hospitalisation[id_patient]), COUNTROWS(ALL(dim_patient)))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 65b2d3c7-c311-45bc-bfda-a4ae11801e6b

	column id_hospitalisation
		dataType: int64
		formatString: 0
		lineageTag: 1119c835-c5cc-4a37-8130-fda678c0a644
		summarizeBy: sum
		sourceColumn: id_hospitalisation

		annotation SummarizationSetBy = Automatic

	column tranche_age
		dataType: string
		lineageTag: 0161f463-e3e1-4e5a-b3c7-ce3f37194b5f
		summarizeBy: none
		sourceColumn: tranche_age

		annotation SummarizationSetBy = Automatic

	column id_patient
		dataType: string
		lineageTag: c4508865-e320-4ed4-aac7-4c27234c428e
		summarizeBy: none
		sourceColumn: id_patient

		annotation SummarizationSetBy = Automatic

	column id_diagnostic
		dataType: string
		lineageTag: b79f5f67-97a3-43ee-8075-775435686b85
		summarizeBy: none
		sourceColumn: id_diagnostic

		annotation SummarizationSetBy = Automatic

	column id_etablissement
		dataType: string
		lineageTag: f5a8b59a-caf2-4256-a417-3147942e5a15
		summarizeBy: none
		sourceColumn: id_etablissement

		annotation SummarizationSetBy = Automatic

	column date_complete
		dataType: dateTime
		formatString: Long Date
		lineageTag: 9b16d9c8-4649-4cd0-b007-6064a59a2f82
		summarizeBy: none
		sourceColumn: date_complete

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition fait_hospitalisation = m
		mode: import
		source =
				let
				    Source = Odbc.DataSource("dsn=Hive Gold", [HierarchicalNavigation=true]),
				    HIVE_Database = Source{[Name="HIVE",Kind="Database"]}[Data],
				    gold_Schema = HIVE_Database{[Name="gold",Kind="Schema"]}[Data],
				    fait_hospitalisation_Table = gold_Schema{[Name="fait_hospitalisation",Kind="Table"]}[Data]
				in
				    fait_hospitalisation_Table

